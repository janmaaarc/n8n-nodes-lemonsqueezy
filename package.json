{
  "name": "n8n-nodes-lemonsqueezy",
  "version": "0.1.0",
  "description": "n8n community node for Lemon Squeezy - digital products and subscriptions platform",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "lemonsqueezy",
    "lemon-squeezy",
    "payments",
    "subscriptions",
    "digital-products"
  ],
  "license": "MIT",
  "homepage": "https://github.com/janmaaarc/n8n-nodes-lemonsqueezy",
  "author": {
    "name": "Jan Marc Coloma",
    "email": "janmarccolomaaa@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janmaaarc/n8n-nodes-lemonsqueezy.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LemonSqueezyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LemonSqueezy/LemonSqueezy.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
